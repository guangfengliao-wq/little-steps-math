{
  "name": "little-steps-math",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/math.test.mjs scripts/*.test.mjs",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "pack": "node scripts/pack.mjs",
    "release": "node scripts/release.mjs",
    "share": "node scripts/apk-install-qr.mjs",
    "release:check": "node scripts/release.mjs --dry-run"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "qrcode": "^1.5.4",
    "typescript": "5.3.3",
    "vite": "^5.0.0",
    "vue-tsc": "^1.8.0"
  }
}
